# Store credentials for local go-webext fallback commands. Copy to .env
# (gitignored), fill the values, and never commit that file. GitHub Actions uses
# the same names as repository variables and secrets; see docs/RELEASE.md.

# Extension-specific store identifiers.
CHROME_APP_ID=cdgepknigaiclfdmjckaknepgcighbnh
EDGE_API_VERSION=v1.1
EDGE_PRODUCT_ID=4a7b03eb-24d8-45e4-8bdd-e0c27fbd9830
FIREFOX_AMO_ID=extensions-update-tracker

# Shared Chrome Web Store publisher credentials.
CHROME_PUBLISHER_ID=
CHROME_CLIENT_ID=
CHROME_CLIENT_SECRET=
CHROME_REFRESH_TOKEN=

# Shared Microsoft Edge Add-ons Publish API credentials.
EDGE_CLIENT_ID=
EDGE_API_KEY=

# Shared Firefox AMO JWT credentials. Use the full original secret.
FIREFOX_CLIENT_ID=
FIREFOX_CLIENT_SECRET=
