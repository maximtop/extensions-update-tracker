{
  "name": "extensions-update-tracker",
  "module": "index.ts",
  "type": "module",
  "license": "MIT",
  "version": "1.3.1",
  "packageManager": "pnpm@11.18.0",
  "author": {
    "name": "Maxim Topciu",
    "email": "me@maximtop.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maximtop/extensions-update-tracker.git"
  },
  "bugs": {
    "url": "https://github.com/maximtop/extensions-update-tracker/issues"
  },
  "homepage": "https://github.com/maximtop/extensions-update-tracker#readme",
  "scripts": {
    "build": "cross-env BUILD_ENV=dev tsx ./scripts/build/index.ts",
    "build:test": "cross-env BUILD_ENV=test tsx ./scripts/build/index.ts",
    "beta": "cross-env BUILD_ENV=beta tsx ./scripts/build/index.ts",
    "prebeta": "pnpm validate-translations",
    "release": "cross-env BUILD_ENV=release tsx ./scripts/build/index.ts",
    "prerelease": "pnpm validate-translations",
    "start": "pnpm build --watch",
    "validate-translations": "node ./scripts/validate-translations.js",
    "convert-store-descriptions": "node ./scripts/convert-store-descriptions.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build:test && playwright test",
    "test:e2e:ui": "pnpm build:test && playwright test --ui",
    "test:e2e:debug": "pnpm build:test && playwright test --debug",
    "check": "pnpm validate-translations && pnpm lint && pnpm typecheck && pnpm test",
    "typecheck": "tsc --noEmit",
    "dev": "pnpm build",
    "package": "pnpm release"
  },
  "dependencies": {
    "@adguard/translate": "^2.0.8",
    "date-fns": "^4.4.0",
    "mobx": "^6.13.0",
    "mobx-react-lite": "^4.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "scheduler": "^0.27.0",
    "use-sync-external-store": "^1.6.0",
    "valibot": "^1.0.0",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.56.1",
    "@rspack/core": "^2.1.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/adm-zip": "0.5.8",
    "@types/chrome": "^0.0.309",
    "@types/node": "^24.13.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/webextension-polyfill": "^0.10.7",
    "@types/yazl": "^3.3.1",
    "adm-zip": "0.6.0",
    "commander": "^12.1.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "eslint": "^10.11.0",
    "eslint-config-airbnb-extended": "3.2.0",
    "eslint-plugin-jsdoc": "64.5.4",
    "globals": "17.12.0",
    "happy-dom": "^17.2.2",
    "playwright": "^1.56.1",
    "style-loader": "^4.0.0",
    "tsx": "^4.19.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "^3.0.7",
    "yazl": "^3.3.1"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
