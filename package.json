{
  "name": "extensions-update-tracker",
  "module": "index.ts",
  "type": "module",
  "license": "MIT",
  "version": "1.3.0",
  "packageManager": "pnpm@10.33.4",
  "author": {
    "name": "Maxim Topciu",
    "email": "me@maximtop.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maximtop/extensions-update-tracker.git"
  },
  "bugs": {
    "url": "https://github.com/maximtop/extensions-update-tracker/issues"
  },
  "homepage": "https://github.com/maximtop/extensions-update-tracker#readme",
  "scripts": {
    "build": "tsx ./scripts/build/index.ts",
    "build:test": "cross-env BUILD_ENV=test tsx ./scripts/build/index.ts",
    "beta": "cross-env BUILD_ENV=beta tsx ./scripts/build/index.ts",
    "prebeta": "pnpm validate-translations",
    "release": "cross-env BUILD_ENV=release tsx ./scripts/build/index.ts",
    "prerelease": "pnpm validate-translations",
    "start": "tsx ./scripts/build/index.ts --watch",
    "validate-translations": "node ./scripts/validate-translations.js",
    "convert-store-descriptions": "node ./scripts/convert-store-descriptions.js",
    "lint": "eslint . --ext .ts,.tsx,.js && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build:test && playwright test",
    "test:e2e:ui": "pnpm build:test && playwright test --ui",
    "test:e2e:debug": "pnpm build:test && playwright test --debug"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "css-loader>@rspack/core": "2"
      }
    }
  },
  "dependencies": {
    "@adguard/translate": "^2.0.8",
    "date-fns": "^4.4.0",
    "mobx": "^6.13.0",
    "mobx-react-lite": "^4.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "scheduler": "^0.27.0",
    "use-sync-external-store": "^1.6.0",
    "valibot": "^1.0.0",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@rspack/core": "^2.1.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/chrome": "^0.0.309",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/webextension-polyfill": "^0.10.7",
    "@types/yazl": "^3.3.1",
    "@typescript-eslint/eslint-plugin": "^7",
    "@typescript-eslint/parser": "^7",
    "commander": "^12.1.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-import-newlines": "^1.4.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-promise": "^6.0.0",
    "eslint-plugin-react": "^7.37.2",
    "happy-dom": "^17.2.2",
    "playwright": "^1.56.1",
    "style-loader": "^4.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.6.3",
    "vitest": "^3.0.7",
    "yazl": "^3.3.1"
  }
}
