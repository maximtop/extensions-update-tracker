{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "types": ["chrome", "node"],
        "jsx": "react",
        "allowJs": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true
    },
    "include": [
        "src/**/*",
        "tests/**/*",
        "scripts/**/*",
        "vitest.config.ts",
        "playwright.config.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
